rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.contentType.matches('image/.*');
    }

    function isWithinSizeLimit(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes;
    }

    // Public read so uploaded photos can be rendered by the mobile app and admin dashboard.
    // Write access is restricted per folder below.

    // Admin dashboard category icons.
    match /category_icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        isImageUpload() &&
        isWithinSizeLimit(2 * 1024 * 1024);
    }

    // User avatar: one canonical file path, overwritten on update.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        fileName == 'avatar.jpg' &&
        isImageUpload() &&
        isWithinSizeLimit(1 * 1024 * 1024);
    }

    // User KYC documents: only the user themselves can write their own KYC documents.
    // Reads are restricted to the user themselves and admin for privacy.
    match /users/{userId}/kyc/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isImageUpload() &&
        isWithinSizeLimit(4 * 1024 * 1024);
    }

    // Item gallery photos: only authenticated users can upload photos.
    match /items/{itemId}/photos/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        isImageUpload() &&
        isWithinSizeLimit(3 * 1024 * 1024);
    }

    // Chat media files
    match /chat_media/{roomId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        isImageUpload() &&
        isWithinSizeLimit(3 * 1024 * 1024);
    }

    // Transaction evidence files: restricted to authenticated users.
    match /transactions/{transactionId}/evidences/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        isImageUpload() &&
        isWithinSizeLimit(4 * 1024 * 1024);
    }

    // Dispute evidence files: restricted to authenticated users.
    match /disputes/{transactionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        isImageUpload() &&
        isWithinSizeLimit(4 * 1024 * 1024);
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
